# Copia a .env.local para desarrollo (no subir .env.local a GitHub)

# Sitio (opcional, para QR y enlaces)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth — misma app en Google Cloud Console
# https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# En Google Cloud → OAuth client → Authorized JavaScript origins:
#   http://localhost:3000
#   https://projectvigia.vercel.app  (tu dominio Vercel)
# Authorized redirect URIs (GIS popup):
#   http://localhost:3000
#   https://projectvigia.vercel.app
