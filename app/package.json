{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next dev --webpack",
    "dev:webpack": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next dev --webpack",
    "dev:turbo": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next dev --turbo",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev:clean": "npm run clean && node --max-old-space-size=8192 ./node_modules/next/dist/bin/next dev --webpack",
    "build": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "generate:canvas-pdf": "node scripts/generate-canvas-pdf.mjs",
    "import:canvas-pdf": "node scripts/import-canvas-pdf.mjs",
    "generate:pitch-guide": "node scripts/generate-pitch-guide.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "canvas": "^3.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "pdfjs-dist": "^5.7.284",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
